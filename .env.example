# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# MCP + IA (semana 3)
MCP_SERVER_URL=http://localhost:3002
MCP_PORT=3002
GEMINI_API_KEY=your-gemini-api-key
# Modelos en orden de fallback (free tier: usar flash-lite o 1.5-flash)
# Lista vigente: node scripts/list-gemini-models.mjs
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash-lite
INTERNAL_SERVICE_KEY=dev-internal-key

# Web (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3001

# Usuarios demo (solo scripts locales; no commitear valor real)
DEMO_USER_PASSWORD=your-demo-password
PLATFORM_ADMIN_PASSWORD=your-admin-password
PLATFORM_ADMIN_EMAIL=your-admin-email@example.com

# E2E Playwright (opcional; CI usa secrets)
# E2E_BASE_URL=https://proptech-web-kappa.vercel.app
# CI (push): smoke + upload mockeado — solo DEMO_USER_PASSWORD
# Full-stack manual/semanal: PLATFORM_ADMIN_PASSWORD (+ opcional E2E_ADMIN_EMAIL)

# Límites API (0 = sin límite en desarrollo local; 3 en producción)
DAILY_ANALYSIS_QUOTA=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
UPLOAD_RATE_LIMIT_MAX=5
