    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.39.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
